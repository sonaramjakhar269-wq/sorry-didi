        <div class="product-rating"><span class="stars">★★★★☆</span><span class="rating-count">(276 reviews)</span></div>
        <div class="product-footer">
          <div><span class="price">₹480<span class="price-unit">/kg</span></span></div>
          <button class="add-btn">Add to Cart</button>
