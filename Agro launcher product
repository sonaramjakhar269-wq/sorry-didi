<script>
  function filterProducts() {
    const q = document.getElementById('searchInput').value.toLowerCase();
    const cards = document.querySelectorAll('.product-card');
    let vis = 0;
    cards.forEach(c => {
      const show = (c.dataset.name || '').includes(q) || q === '';
      c.style.display = show ? 'block' : 'none';
      if (show) vis++;
    });
    document.getElementById('noResults').style.display = vis === 0 ? 'block' : 'none';
  }
  function filterByTag(btn, tag) {
    document.querySelectorAll('.tag').forEach(t => t.classList.remove('active'));
    btn.classList.add('active');
    const cards = document.querySelectorAll('.product-card');
    let vis = 0;
    cards.forEach(c => {
      const show = tag === 'all' || c.dataset.tag === tag;
      c.style.display = show ? 'block' : 'none';
      if (show) vis++;
    });
    document.getElementById('noResults').style.display = vis === 0 ? 'block' : 'none';
    document.getElementById('searchInput').value = '';
  }
  let cart = 0;
  document.querySelectorAll('.add-btn').forEach(btn => {
    btn.addEventListener('click', function() {
      cart++;
      document.querySelector('.nav-cart').textContent = `🛒 Cart (${cart})`;
      this.textContent = '✓ Added!';
      this.style.background = '#40916c';
      setTimeout(() => { this.textContent = 'Add to Cart'; this.style.background = ''; }, 1500);
    });
  });
  document.querySelectorAll('a[href^="#"]').forEach(a => {
    a.addEventListener('click', e => { e.preventDefault(); document.querySelector(a.getAttribute('href'))?.scrollIntoView({ behavior: 'smooth' }); });
  });
  function submitForm(e) {
    e.preventDefault();
    alert('✅ Enquiry sent! Our team will contact you within 24 hours.');
    e.target.reset(); return false;
  }
</script>
