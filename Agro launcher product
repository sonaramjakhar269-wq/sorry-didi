    <input type="text" id="searchInput" placeholder="Search seeds, fertilizers, tools…" oninput="filterProducts()">
    <button class="search-btn" onclick="filterProducts()">Search</button>
  </div>
</div>
<div class="filter-tags">
  <button class="tag active" onclick="filterByTag(this,'all')">All</button>
  <button class="tag" onclick="filterByTag(this,'seeds')">🌾 Seeds</button>
  <button class="tag" onclick="filterByTag(this,'fertilizer')">🧪 Fertilizers</button>
  <button class="tag" onclick="filterByTag(this,'pesticide')">🛡️ Pesticides</button>
  <button class="tag" onclick="filterByTag(this,'tools')">🔧 Farm Tools</button>
  <button class="tag" onclick="filterByTag(this,'organic')">🌿 Organic</button>
</div>

<section class="products-section" id="products">
  <div class="section-header">
    <span class="section-tag">Our Catalogue</span>
    <h2>Featured Products</h2>
    <p>Verified quality. Competitive prices. Fast delivery to your doorstep.</p>
  </div>
  <div class="products-grid" id="productsGrid">

