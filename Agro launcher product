<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>AgriLauncher — Premium Agricultural Products</title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
  :root {
    --green-deep: #1a3a2a;
    --green-mid: #2d6a4f;
    --green-bright: #40916c;
    --green-light: #74c69d;
    --gold: #d4a017;
    --cream: #f8f4ec;
    --white: #ffffff;
    --text-dark: #0d2118;
    --text-muted: #5a7a68;
    --card-bg: #ffffff;
    --shadow: 0 8px 40px rgba(26,58,42,0.12);
  }
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body { font-family: 'DM Sans', sans-serif; background: var(--cream); color: var(--text-dark); overflow-x: hidden; }

  nav {
    position: fixed; top: 0; width: 100%; z-index: 100;
    background: rgba(26,58,42,0.97); backdrop-filter: blur(12px);
    padding: 0 5%; display: flex; align-items: center; justify-content: space-between;
    height: 68px; border-bottom: 1px solid rgba(116,198,157,0.2);
  }
  .nav-logo { font-family: 'Playfair Display', serif; font-size: 1.5rem; font-weight: 900; color: var(--green-light); letter-spacing: -0.5px; }
  .nav-logo span { color: var(--gold); }
  .nav-links { display: flex; gap: 2rem; list-style: none; }
  .nav-links a { color: rgba(255,255,255,0.8); text-decoration: none; font-size: 0.9rem; font-weight: 500; transition: color 0.2s; }
  .nav-links a:hover { color: var(--green-light); }
  .nav-cart { background: var(--gold); color: var(--green-deep); border: none; padding: 8px 20px; border-radius: 50px; font-weight: 700; font-size: 0.85rem; cursor: pointer; transition: transform 0.2s, box-shadow 0.2s; }
  .nav-cart:hover { transform: translateY(-1px); box-shadow: 0 4px 16px rgba(212,160,23,0.4); }

  .hero {
    min-height: 100vh; background: linear-gradient(135deg, var(--green-deep) 0%, #0d2118 40%, #1e4d35 100%);
    display: flex; align-items: center; justify-content: center; text-align: center; padding: 100px 5% 60px; position: relative; overflow: hidden;
  }
  .hero::before { content: ''; position: absolute; inset: 0; background: radial-gradient(ellipse 80% 60% at 50% 60%, rgba(64,145,108,0.15) 0%, transparent 70%); }
  .hero-badge { display: inline-block; background: rgba(116,198,157,0.15); border: 1px solid rgba(116,198,157,0.4); color: var(--green-light); padding: 6px 18px; border-radius: 50px; font-size: 0.8rem; font-weight: 600; letter-spacing: 1.5px; text-transform: uppercase; margin-bottom: 1.5rem; animation: fadeUp 0.6s ease both; }
  .hero h1 { font-family: 'Playfair Display', serif; font-size: clamp(2.8rem, 7vw, 5.5rem); font-weight: 900; color: var(--white); line-height: 1.05; margin-bottom: 1.2rem; animation: fadeUp 0.6s 0.1s ease both; }
  .hero h1 span { color: var(--gold); }
  .hero p { font-size: 1.1rem; color: rgba(255,255,255,0.65); max-width: 560px; margin: 0 auto 2.5rem; line-height: 1.7; animation: fadeUp 0.6s 0.2s ease both; }
  .hero-btns { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; animation: fadeUp 0.6s 0.3s ease both; }
  .btn-primary { background: var(--gold); color: var(--green-deep); border: none; padding: 14px 36px; border-radius: 50px; font-size: 1rem; font-weight: 700; cursor: pointer; transition: all 0.25s; text-decoration: none; display: inline-block; }
  .btn-primary:hover { transform: translateY(-2px); box-shadow: 0 8px 28px rgba(212,160,23,0.45); }
  .btn-outline { background: transparent; color: var(--white); border: 1.5px solid rgba(255,255,255,0.35); padding: 14px 36px; border-radius: 50px; font-size: 1rem; font-weight: 500; cursor: pointer; transition: all 0.25s; text-decoration: none; display: inline-block; }
  .btn-outline:hover { border-color: var(--green-light); color: var(--green-light); }
  .hero-stats { display: flex; gap: 3rem; justify-content: center; flex-wrap: wrap; margin-top: 4rem; padding-top: 3rem; border-top: 1px solid rgba(255,255,255,0.1); animation: fadeUp 0.6s 0.4s ease both; }
  .stat-num { font-family: 'Playfair Display', serif; font-size: 2rem; font-weight: 900; color: var(--gold); display: block; }
  .stat-label { font-size: 0.8rem; color: rgba(255,255,255,0.5); text-transform: uppercase; letter-spacing: 1px; }

  .search-section { background: var(--green-deep); padding: 30px 5%; display: flex; justify-content: center; }
  .search-bar { display: flex; align-items: center; background: rgba(255,255,255,0.08); border: 1.5px solid rgba(116,198,157,0.3); border-radius: 50px; padding: 6px 6px 6px 24px; width: 100%; max-width: 700px; transition: border-color 0.2s, box-shadow 0.2s; }
  .search-bar:focus-within { border-color: var(--green-light); box-shadow: 0 0 0 4px rgba(116,198,157,0.1); }
  .search-bar input { flex: 1; background: transparent; border: none; outline: none; color: var(--white); font-size: 1rem; font-family: 'DM Sans', sans-serif; }
  .search-bar input::placeholder { color: rgba(255,255,255,0.4); }
  .search-btn { background: var(--green-bright); color: var(--white); border: none; padding: 10px 24px; border-radius: 50px; font-weight: 600; font-size: 0.9rem; cursor: pointer; transition: background 0.2s; }
  .search-btn:hover { background: var(--green-light); color: var(--green-deep); }
  .filter-tags { display: flex; gap: 0.6rem; padding: 14px 5% 20px; justify-content: center; flex-wrap: wrap; background: var(--green-deep); }
  .tag { padding: 5px 16px; border-radius: 50px; font-size: 0.8rem; font-weight: 500; cursor: pointer; transition: all 0.2s; border: 1px solid rgba(116,198,157,0.3); color: rgba(255,255,255,0.6); background: transparent; }
  .tag.active, .tag:hover { background: var(--green-bright); color: white; border-color: var(--green-bright); }

  .products-section { padding: 70px 5%; }
  .section-header { text-align: center; margin-bottom: 3rem; }
  .section-tag { font-size: 0.75rem; font-weight: 700; letter-spacing: 2px; text-transform: uppercase; color: var(--green-bright); display: block; margin-bottom: 0.6rem; }
  .section-header h2 { font-family: 'Playfair Display', serif; font-size: clamp(1.8rem, 4vw, 2.8rem); font-weight: 900; color: var(--green-deep); }
  .section-header p { color: var(--text-muted); margin-top: 0.6rem; }
  .products-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1.5rem; max-width: 1200px; margin: 0 auto; }
  .product-card { background: var(--card-bg); border-radius: 20px; box-shadow: var(--shadow); overflow: hidden; transition: transform 0.3s, box-shadow 0.3s; border: 1px solid rgba(26,58,42,0.07); }
  .product-card:hover { transform: translateY(-6px); box-shadow: 0 20px 60px rgba(26,58,42,0.16); }
  .product-img { height: 190px; display: flex; align-items: center; justify-content: center; font-size: 4rem; position: relative; overflow: hidden; }
  .badge-new { position: absolute; top: 14px; left: 14px; background: var(--green-bright); color: white; font-size: 0.65rem; font-weight: 700; letter-spacing: 1px; text-transform: uppercase; padding: 4px 10px; border-radius: 50px; }
  .badge-hot { position: absolute; top: 14px; left: 14px; background: #e63946; color: white; font-size: 0.65rem; font-weight: 700; letter-spacing: 1px; text-transform: uppercase; padding: 4px 10px; border-radius: 50px; }
  .product-body { padding: 1.4rem; }
  .product-cat { font-size: 0.7rem; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase; color: var(--green-bright); margin-bottom: 0.4rem; }
  .product-name { font-family: 'Playfair Display', serif; font-size: 1.2rem; font-weight: 700; color: var(--green-deep); margin-bottom: 0.4rem; }
  .product-desc { font-size: 0.85rem; color: var(--text-muted); line-height: 1.6; margin-bottom: 1rem; }
  .product-rating { display: flex; align-items: center; gap: 6px; margin-bottom: 1rem; }
  .stars { color: var(--gold); font-size: 0.85rem; }
  .rating-count { font-size: 0.78rem; color: var(--text-muted); }
  .product-footer { display: flex; align-items: center; justify-content: space-between; }
  .price { font-family: 'Playfair Display', serif; font-size: 1.4rem; font-weight: 900; color: var(--green-deep); }
  .price-unit { font-family: 'DM Sans', sans-serif; font-size: 0.75rem; color: var(--text-muted); font-weight: 400; }
  .old-price { font-size: 0.85rem; text-decoration: line-through; color: #aaa; font-weight: 400; margin-left: 6px; }
  .add-btn { background: var(--green-deep); color: white; border: none; padding: 9px 20px; border-radius: 50px; font-size: 0.82rem; font-weight: 600; cursor: pointer; transition: background 0.2s, transform 0.15s; }
  .add-btn:hover { background: var(--green-bright); transform: scale(1.04); }

  .details-section { background: var(--green-deep); padding: 80px 5%; color: white; }
  .details-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; max-width: 1100px; margin: 0 auto; align-items: center; }
  .details-text h2 { font-family: 'Playfair Display', serif; font-size: clamp(1.8rem, 3.5vw, 2.6rem); font-weight: 900; color: white; margin-bottom: 1.2rem; }
  .details-text h2 span { color: var(--gold); }
  .details-text p { color: rgba(255,255,255,0.65); line-height: 1.8; margin-bottom: 1.5rem; }
  .feature-list { list-style: none; display: flex; flex-direction: column; gap: 0.8rem; }
  .feature-list li { display: flex; align-items: center; gap: 12px; color: rgba(255,255,255,0.85); font-size: 0.95rem; }
  .feature-list li::before { content: '✓'; color: var(--green-light); font-weight: 800; }
  .details-card { background: rgba(255,255,255,0.05); border: 1px solid rgba(116,198,157,0.2); border-radius: 20px; padding: 2rem; display: grid; grid-template-columns: 1fr 1fr; gap: 1.2rem; }
  .spec-item { background: rgba(255,255,255,0.05); border-radius: 12px; padding: 1rem; }
  .spec-label { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 1px; color: var(--green-light); margin-bottom: 0.3rem; }
  .spec-value { font-family: 'Playfair Display', serif; font-size: 1.2rem; font-weight: 700; color: white; }

  .rates-section { padding: 80px 5%; background: var(--cream); }
  .rates-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 1.5rem; max-width: 1000px; margin: 0 auto; }
  .rate-card { background: white; border-radius: 20px; padding: 2rem; border: 2px solid transparent; text-align: center; box-shadow: var(--shadow); transition: all 0.3s; position: relative; overflow: hidden; }
  .rate-card.featured { border-color: var(--green-bright); background: linear-gradient(145deg, #fff 0%, #f0faf5 100%); }
  .rate-card.featured::before { content: 'BEST VALUE'; position: absolute; top: 16px; right: -24px; background: var(--green-bright); color: white; font-size: 0.6rem; font-weight: 800; letter-spacing: 1.5px; padding: 5px 32px; transform: rotate(45deg); }
  .rate-card:hover { transform: translateY(-4px); box-shadow: 0 16px 50px rgba(26,58,42,0.14); }
  .rate-icon { font-size: 2.8rem; margin-bottom: 0.8rem; display: block; }
  .rate-name { font-family: 'Playfair Display', serif; font-size: 1.3rem; font-weight: 700; color: var(--green-deep); margin-bottom: 0.3rem; }
  .rate-qty { font-size: 0.8rem; color: var(--text-muted); margin-bottom: 1.2rem; }
  .rate-price { font-family: 'Playfair Display', serif; font-size: 2.4rem; font-weight: 900; color: var(--green-deep); line-height: 1; }
  .rate-price sub { font-size: 1rem; font-weight: 400; vertical-align: middle; }
  .rate-price sup { font-size: 1rem; }
  .rate-divider { border: none; border-top: 1px solid #eee; margin: 1.2rem 0; }
  .rate-features { list-style: none; text-align: left; display: flex; flex-direction: column; gap: 0.5rem; }
  .rate-features li { font-size: 0.85rem; color: var(--text-muted); display: flex; align-items: center; gap: 8px; }
  .rate-features li::before { content: '•'; color: var(--green-bright); font-size: 1.2rem; }
  .rate-btn { margin-top: 1.5rem; width: 100%; padding: 11px; border-radius: 50px; font-size: 0.9rem; font-weight: 700; cursor: pointer; border: none; background: var(--green-deep); color: white; transition: background 0.2s; }
  .rate-btn:hover { background: var(--green-bright); }
  .rate-card.featured .rate-btn { background: var(--green-bright); }

  .why-section { padding: 80px 5%; background: white; }
  .why-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 1.5rem; max-width: 1100px; margin: 0 auto; }
  .why-card { padding: 1.8rem; border-radius: 16px; background: var(--cream); text-align: center; transition: transform 0.3s; }
  .why-card:hover { transform: translateY(-4px); }
  .why-icon { font-size: 2.5rem; margin-bottom: 0.8rem; display: block; }
  .why-title { font-family: 'Playfair Display', serif; font-size: 1.1rem; font-weight: 700; color: var(--green-deep); margin-bottom: 0.4rem; }
  .why-desc { font-size: 0.85rem; color: var(--text-muted); line-height: 1.6; }

  .contact-section { background: linear-gradient(135deg, var(--green-deep), #0d2118); padding: 80px 5%; color: white; text-align: center; }
  .contact-section h2 { font-family: 'Playfair Display', serif; font-size: clamp(1.8rem, 4vw, 2.8rem); font-weight: 900; margin-bottom: 0.8rem; }
  .contact-section h2 span { color: var(--gold); }
  .contact-section > p { color: rgba(255,255,255,0.6); margin-bottom: 2.5rem; max-width: 500px; margin-left: auto; margin-right: auto; }
  .contact-form { display: flex; flex-direction: column; gap: 1rem; max-width: 480px; margin: 0 auto; }
  .contact-form input, .contact-form textarea { background: rgba(255,255,255,0.08); border: 1.5px solid rgba(116,198,157,0.25); border-radius: 12px; padding: 14px 18px; color: white; font-size: 0.95rem; font-family: 'DM Sans', sans-serif; outline: none; resize: none; transition: border-color 0.2s; }
  .contact-form input::placeholder, .contact-form textarea::placeholder { color: rgba(255,255,255,0.35); }
  .contact-form input:focus, .contact-form textarea:focus { border-color: var(--green-light); }
  .contact-form button { background: var(--gold); color: var(--green-deep); border: none; padding: 14px; border-radius: 50px; font-size: 1rem; font-weight: 700; cursor: pointer; transition: all 0.2s; }
  .contact-form button:hover { transform: translateY(-2px); box-shadow: 0 8px 24px rgba(212,160,23,0.4); }
  .contact-info { display: flex; justify-content: center; gap: 3rem; flex-wrap: wrap; margin-top: 3.5rem; padding-top: 3rem; border-top: 1px solid rgba(255,255,255,0.1); }
  .contact-item-icon { font-size: 1.8rem; margin-bottom: 0.5rem; display: block; }
  .contact-item-label { font-size: 0.75rem; text-transform: uppercase; letter-spacing: 1px; color: rgba(255,255,255,0.4); margin-bottom: 0.3rem; }
  .contact-item-val { font-size: 0.95rem; color: var(--green-light); }

  footer { background: #0a1f15; padding: 24px 5%; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 8px; font-size: 0.82rem; color: rgba(255,255,255,0.35); border-top: 1px solid rgba(255,255,255,0.06); }

  @keyframes fadeUp { from { opacity: 0; transform: translateY(24px); } to { opacity: 1; transform: translateY(0); } }
  @media (max-width: 768px) { .nav-links { display: none; } .details-grid { grid-template-columns: 1fr; gap: 2rem; } .hero-stats { gap: 1.5rem; } footer { flex-direction: column; text-align: center; } }
</style>
</head>
<body>

<nav>
  <div class="nav-logo">Agri<span>Launcher</span></div>
  <ul class="nav-links">
    <li><a href="#products">Products</a></li>
    <li><a href="#details">Details</a></li>
    <li><a href="#rates">Rates</a></li>
    <li><a href="#why">Why Us</a></li>
    <li><a href="#contact">Contact</a></li>
  </ul>
  <button class="nav-cart">🛒 Cart (0)</button>
</nav>

<section class="hero">
  <div>
    <div class="hero-badge">🌱 India's #1 Agricultural Products</div>
    <h1>Grow <span>Smarter.</span><br>Harvest Better.</h1>
    <p>Premium seeds, fertilizers, pesticides & farm tools — trusted by 50,000+ farmers across India.</p>
    <div class="hero-btns">
      <a href="#products" class="btn-primary">Shop Products</a>
      <a href="#rates" class="btn-outline">View Rates</a>
    </div>
    <div class="hero-stats">
      <div class="stat-item"><span class="stat-num">50K+</span><span class="stat-label">Happy Farmers</span></div>
      <div class="stat-item"><span class="stat-num">200+</span><span class="stat-label">Products</span></div>
